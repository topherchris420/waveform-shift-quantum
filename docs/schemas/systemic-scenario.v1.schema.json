          "fundingDependency": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "transferLimit": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000000000
          },
          "transferRestricted": {
            "type": "boolean"
          },
          "spreadBps": {
            "type": "number",
            "minimum": 0,
            "maximum": 10000
          }
