          "creditor",
          "debtor",
          "kind",
          "fundingKind",
          "principal",
          "creditorAccount",
          "debtorAccount",
          "securedAmount",
          "collateralIds",
          "maturityHour",
          "rolloverProbability",
          "lossGivenDefault",
          "fundingDependency",
          "transferLimit",
          "transferRestricted",
          "spreadBps"
        ],
        "additionalProperties": false
      }
