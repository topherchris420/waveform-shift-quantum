{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "systemic-signal.v1"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[A-Za-z0-9_.:/-]+$"
    },
    "institution": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^[A-Za-z0-9_.:/-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "required": [
        "id",
        "name"
      ],
      "additionalProperties": false
    },
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "affectedMetrics": {
      "minItems": 1,
      "maxItems": 6,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "metric": {
            "type": "string",
            "enum": [
              "funding_pressure",
              "liquidity_shortfall",
              "collateral_value",
              "securities_value",
              "payment_delay",
              "peer_divergence"
            ]
          },
          "direction": {
            "type": "string",
            "enum": [
              "increase",
              "decrease",
              "unchanged"
            ]
          },
          "magnitude": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000000000
          },
          "units": {
            "type": "string",
            "enum": [
              "fraction",
              "percent",
              "USD million",
              "hours",
              "z-score"
            ]
          },
          "baseline": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1000000000
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "metric",
          "direction",
          "magnitude",
          "units",
          "baseline"
        ],
        "additionalProperties": false
      }
    },
    "peerContext": {
      "type": "object",
      "properties": {
        "group": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "sampleSize": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "percentile": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "group",
        "sampleSize",
        "percentile"
      ],
      "additionalProperties": false
    },
    "direction": {
      "type": "string",
      "enum": [
        "deteriorating",
        "improving",
        "mixed",
        "unclear"
      ]
    },
    "magnitude": {
      "type": "number",
      "minimum": 0,
      "maximum": 1000000000
    },
    "persistenceDays": {
      "type": "number",
      "minimum": 0,
      "maximum": 10000
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "robustness": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "topologyChanges": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^[A-Za-z0-9_.:/-]+$"
          },
          "to": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^[A-Za-z0-9_.:/-]+$"
          },
          "change": {
            "type": "string",
            "enum": [
              "added",
              "removed",
              "strengthened",
              "weakened"
            ]
          },
          "evidenceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^[A-Za-z0-9_.:/-]+$"
          }
        },
        "required": [
          "from",
          "to",
          "change",
          "evidenceId"
        ],
        "additionalProperties": false
      }
    },
    "leadLagRelationships": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "leading": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^[A-Za-z0-9_.:/-]+$"
          },
          "lagging": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^[A-Za-z0-9_.:/-]+$"
          },
          "lagDays": {
            "type": "number",
            "minimum": -10000,
            "maximum": 10000
          },
          "association": {
            "type": "number",
            "minimum": -1,
            "maximum": 1
          },
          "evidenceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^[A-Za-z0-9_.:/-]+$"
          }
        },
        "required": [
          "leading",
          "lagging",
          "lagDays",
          "association",
          "evidenceId"
        ],
        "additionalProperties": false
      }
    },
    "provenance": {
      "minItems": 1,
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "sourceDate": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "method": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "required": [
          "source",
          "sourceDate",
          "method"
        ],
        "additionalProperties": false
      }
    },
    "evidenceIds": {
      "minItems": 1,
      "maxItems": 1000,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120,
        "pattern": "^[A-Za-z0-9_.:/-]+$"
      }
    }
  },
  "required": [
    "schema",
    "id",
    "institution",
    "date",
    "affectedMetrics",
    "peerContext",
    "direction",
    "magnitude",
    "persistenceDays",
    "confidence",
    "robustness",
    "topologyChanges",
    "leadLagRelationships",
    "provenance",
    "evidenceIds"
  ],
  "additionalProperties": false,
  "$id": "https://github.com/topherchris420/waveform-shift-quantum/blob/main/docs/schemas/systemic-signal.v1.schema.json"
}
